{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiejiananaa-github-io",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}